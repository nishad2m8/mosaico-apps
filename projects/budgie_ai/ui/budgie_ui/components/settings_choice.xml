<!--
 @title Settings choice
 @brief Title + description, then a full-width segmented control. Put settings_option children inside;
        they are laid out in the track below the labels.
-->
<component>
	<api>
		<prop name="title" type="string" default="Screen off after"/>
		<prop name="subtitle" type="string" default="Dims the screen when Budgie is idle"/>
	</api>

	<previews>
		<preview name="light" width="448" height="120" style_bg_color="#color_card" style_bg_opa="255" style_pad_all="0"/>
	</previews>

	<view extends="lv_obj" width="100%" height="content" scrollable="false"
		style_bg_opa="0" style_border_width="0" style_radius="0" style_pad_hor="16" style_pad_ver="14" style_pad_row="2" style_pad_column="6"
		style_layout="flex" style_flex_flow="row_wrap">
		<lv_label name="title_label" text="$title" width="100%" style_text_font="font_row_title" style_text_color="#color_text"/>
		<lv_label name="subtitle_label" text="$subtitle" width="100%" long_mode="wrap" style_text_font="font_body" style_text_color="#color_muted"
			style_margin_bottom="10"/>
	</view>
</component>
